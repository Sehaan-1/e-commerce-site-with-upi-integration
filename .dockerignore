# Dependencies — re-installed during docker build
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output — rebuilt during docker build
.next
out

# Environment files — injected at runtime, never baked into image
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Editor / OS artifacts
.DS_Store
.vscode
.idea
*.swp
*.swo
Thumbs.db

# Test artifacts
coverage
.nyc_output
test-results
playwright-report

# Documentation (not needed at runtime)
docs
*.md

# CI/CD
.github

# Local scripts (not needed in container)
scripts/setup-local.*

# TypeScript build info
*.tsbuildinfo
