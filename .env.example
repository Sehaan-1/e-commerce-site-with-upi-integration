# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── Store ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="Kalpa Living"
NEXT_PUBLIC_BASE_URL=http://localhost:3000     # your public https URL in production (used in email links + webhook URL)
SUPPORT_EMAIL=support@example.com
FREE_SHIPPING_THRESHOLD_PAISE=99900            # ₹999
FLAT_SHIPPING_PAISE=7900                       # ₹79

# ─── Admin ────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me                        # login at /admin
ADMIN_SESSION_SECRET=any-long-random-string     # signs the admin cookie (openssl rand -hex 32)

# ─── UPI payments (Razorpay) ──────────────────────────────────────────────
# Leave these blank to use the built-in UPI sandbox simulator (no real money).
# Test keys start with rzp_test_, live keys with rzp_live_.
PAYMENT_MODE=auto                               # auto | razorpay | sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                        # Dashboard → Settings → Webhooks
MERCHANT_UPI_ID=yourstore@upi                   # shown in the sandbox QR only

# ─── Transactional email (any SMTP) ───────────────────────────────────────
# Leave SMTP_HOST blank to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Kalpa Living <orders@yourdomain.com>"

# ─── Future gateways (not enabled yet) ────────────────────────────────────
# STRIPE_SECRET_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# SQUARE_ACCESS_TOKEN=
