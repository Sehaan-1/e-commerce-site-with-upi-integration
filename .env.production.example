# ─────────────────────────────────────────────────────────────────────────────
# Kalpa Living — Production Environment Variables
# Copy this file to .env (or inject these via your hosting platform's secret
# manager). NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────
# Use a managed Postgres service in production (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ─── Store ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="Kalpa Living"
NEXT_PUBLIC_BASE_URL=https://your-production-domain.com
SUPPORT_EMAIL=support@your-production-domain.com
FREE_SHIPPING_THRESHOLD_PAISE=99900        # ₹999 — adjust as needed
FLAT_SHIPPING_PAISE=7900                   # ₹79  — adjust as needed

# ─── Admin ────────────────────────────────────────────────────────────────
# CRITICAL: Change these from defaults before going live!
# Generate with: openssl rand -base64 32
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_GENERATE_VIA_openssl_rand_hex_32

# ─── UPI Payments (Razorpay) ──────────────────────────────────────────────
# Use live keys in production (rzp_live_*)
# Test keys start with rzp_test_ — never use test keys in production!
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCHANT_UPI_ID=yourstore@bank

# ─── Transactional Email ──────────────────────────────────────────────────
# Use a transactional email provider (SendGrid, Postmark, Brevo, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM="Kalpa Living <orders@your-production-domain.com>"

# ─── Optional: Sentry / Observability (add if using Sentry) ──────────────
# SENTRY_DSN=https://xxxxxxxx@oXXXXXXXX.ingest.sentry.io/XXXXXXXX
# SENTRY_ORG=your-org
# SENTRY_PROJECT=kalpa-living
